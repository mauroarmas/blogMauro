{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/admin/layout,_N_T_/[lang]/admin/login/layout,_N_T_/[lang]/admin/login/page,_N_T_/en/admin/login"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/admin/login/__PAGE__",
    "/$d$lang/admin/login",
    "/$d$lang/admin",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}